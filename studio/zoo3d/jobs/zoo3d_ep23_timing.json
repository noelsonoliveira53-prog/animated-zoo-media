n": "chorus1"}, {"text": "Splash in the water, sing with me!", "start": 12.62, "end": 16.62, "who": "host", "kind": "sing", "section": "chorus1"}, {"text": "Orange coat and stripes so dark,", "start": 16.84, "end": 19.66, "who": "host", "kind": "sing", "section": "verse1"}, {"text": "Padding softly through the park!", "start": 21.02, "end": 23.7, "who": "host", "kind": "sing", "section": "verse1"}, {"text": "Bigger than the house cat, big as can be,", "start": 25.2, "end": 28.56, "who": "host", "kind": "sing", "section": "verse1"}, {"text": "The biggest wild cat, look and see!", "start": 29.02, "end": 33.44, "who": "host", "kind": "sing", "section": "verse1"}, {"text": "Who is big? Who is big?", "start": 33.5, "end": 37.33, "who": "host", "kind": "sing", "section": "prechorus1"}, {"text": "The tiger cat is really big!", "start": 37.42, "end": 42.31, "who": "host", "kind": "sing", "section": "prechorus1"}, {"text": "Stripes and splashes, here we go!", "start": 44.08, "end": 47.84, "who": "host", "kind": "sing", "section": "chorus2"}, {"text": "The tiger is the biggest cat we know!", "start": 47.84, "end": 52.24, "who": "host", "kind": "sing", "section": "chorus2"}, {"text": "Orange and stripy, one, two, three,", "start": 52.24, "end": 56.28, "who": "host", "kind": "sing", "section": "chorus2"}, {"text": "Splash in the water, sing with me!", "start": 56.38, "end": 60.42, "who": "host", "kind": "sing", "section": "chorus2"}, {"text": "Most cats stay away from the rain,", "start": 60.42, "end": 64.16, "who": "host", "kind": "sing", "section": "verse2"}, {"text": "But tigers jump in again and again!", "start": 64.48, "end": 68.86, "who": "host", "kind": "sing", "section": "verse2"}, {"text": "Paddle, paddle, swim so well,", "start": 69.0, "end": 71.86, "who": "host", "kind": "sing", "section": "verse2"}, {"text": "Splishy, splashy, tiger swell!", "start": 72.62, "end": 77.3, "who": "host", "kind": "sing", "section": "verse2"}, {"text": "Paddle your paws! (Paddle, paddle!)", "start": 77.32, "end": 81.2, "who": "host", "kind": "sing", "section": "bridge1"}, {"text": "Make a splash! (Splash, splash, splash!)", "start": 81.54, "end": 85.38, "who": "host", "kind": "sing", "section": "bridge1"}, {"text": "Swish your tail! (Swish, swish, swish!)", "start": 85.7, "end": 89.28, "who": "host", "kind": "sing", "section": "bridge1"}, {"text": "Now shake off the water, quick as a flash!", "start": 89.38, "end": 93.72, "who": "host", "kind": "sing", "section": "bridge1"}, {"text": "Look at the stripes, every one,", "start": 93.94, "end": 97.46, "who": "host", "kind": "sing", "section": "verse3"}, {"text": "No two tigers have the same, what fun!", "start": 97.68, "end": 101.22, "who": "host", "kind": "sing", "section": "verse3"}, {"text": "Little cubs stay close to Mama, you see,", "start": 101.74, "end": 105.9, "who": "host", "kind": "sing", "section": "verse3"}, {"text": "Snuggled up as cozy as can be!", "start": 105.96, "end": 110.68, "who": "host", "kind": "sing", "section": "verse3"}, {"text": "Who is big? Who is big?", "start": 110.7, "end": 114.33, "who": "host", "kind": "sing", "section": "prechorus2"}, {"text": "The tiger cat is really big!", "start": 114.64, "end": 120.66, "who": "host", "kind": "sing", "section": "prechorus2"}, {"text": "Stripes and splashes, here we go!", "start": 121.3, "end": 124.98, "who": "host", "kind": "sing", "section": "chorus3"}, {"text": "The tiger is the biggest cat we know!", "start": 125.0, "end": 128.98, "who": "host", "kind": "sing", "section": "chorus3"}, {"text": "We splashed and sang, one, two, three,", "start": 128.98, "end": 133.52, "who": "host", "kind": "sing", "section": "chorus3"}, {"text": "Stripes and splashes, sing with me!", "start": 133.52, "end": 139.56, "who": "host", "kind": "sing", "section": "chorus3"}, {"text": "Stripes and splashes! Bye-bye, friends!", "start": 139.72, "end": 150.96, "who": "host", "kind": "sing", "section": "outro1"}], "words": [{"w": "Stripes", "start": 0.26, "end