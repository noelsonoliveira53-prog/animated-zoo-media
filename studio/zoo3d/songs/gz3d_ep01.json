    }
   ]
  },
  {
   "section": "verse1",
   "lines": [
    {
     "text": "Mercury, Mercury, closest to the Sun,",
     "notes": "E4:.5,E4:.5,E4:.5 G4:.5,G4:.5,G4:.5 A4:.5,G4:.5 E4:1 D4:1 C4:2",
     "rest": 0
    },
    {
     "text": "Tiny and speedy, zoom, zoom, zoom!",
     "notes": "D4:.5,D4:.5 E4:1 F4:.5,F4:.5 A4:1 G4:1 E4:3",
     "rest": 0
    },
    {
     "text": "Venus, Venus, hottest one of all,",
     "notes": "E4:.5,E4:1 G4:.5,G4:1 A4:.5,G4:.5 E4:1 D4:1 C4:2",
     "rest": 0
    },
    {
     "text": "Thick clouds hide it, hot, hot, hot!",
     "notes": "D4:.5 D4:.5 E4:.5 F4:.5 A4:1 G4:1 E4:2",
     "rest": 2
    },
    {
     "text": "Earth, Earth, our home sweet home,",
     "notes": "E4:1 G4:1 A4:1 G4:1 E4:1 C4:3",
     "rest": 0
    },
    {
     "text": "Water, plants, and you and me!",
     "notes": "D4:.5,D4:.5 E4:1 F4:1 A4:1 G4:1 E4:3",
     "rest": 0
    }
   ]
  },
